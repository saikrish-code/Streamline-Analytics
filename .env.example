POSTGRES_DB=streamline
POSTGRES_USER=streamline
POSTGRES_PASSWORD=streamline_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://streamline:streamline_local@localhost:5432/streamline
OLIST_DATA_DIR=data/raw
LOAD_CHUNK_SIZE=5000
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=olist.order-events
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_GROUP_ID=streamline-order-events-to-postgres
PRODUCER_INTERVAL_SECONDS=1.0
PRODUCER_STATUS_CHANGE_RATE=0.4
