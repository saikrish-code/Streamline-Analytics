streamline_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      user: "{{ env_var('POSTGRES_USER', 'streamline') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'streamline_local') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      dbname: "{{ env_var('POSTGRES_DB', 'streamline') }}"
      schema: public
      threads: 4
