# Neon pooled Postgres connection string (or compatible serverless PostgreSQL URL).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Public base URL for the deployed FastAPI churn service.
CHURN_API_URL=https://your-churn-api.example.com
# Set this in Vercel so /api/refresh only accepts authenticated Cron requests.
CRON_SECRET=replace-with-a-long-random-secret
